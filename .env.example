# Copy this file to .env and fill values locally. Never commit .env.

# API server
PORT=8000
HOST=127.0.0.1
FRONTEND_ORIGINS=http://localhost:5173
# Public URL n8n uses to call back into Saathi.
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# At least 32 random characters. If unset, an ephemeral secret is generated and sessions reset on restart.
JWT_SECRET_KEY=replace-with-a-long-random-local-secret
# Set true only when running behind a reverse proxy, so rate limits see the client IP.
TRUST_PROXY=false
LOGIN_ATTEMPTS_PER_MINUTE=10
# "Today" for proactive alerts, so the synthetic EMI is always due in two days.
DEMO_DATE=2026-10-03

# OpenAI (redacted evidence summaries, consent per request)
OPENAI_API_KEY=
# Set true only after adding a newly rotated key locally.
OPENAI_ENABLED=false
OPENAI_MODEL=gpt-4o-mini

# Sarvam (speech-to-text, translation, and read-aloud in 11 languages; consent per request)
SARVAM_API_KEY=
# Set true only after adding a newly rotated key locally.
SARVAM_ENABLED=false
SARVAM_STT_MODEL=saaras:v4
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka

# n8n partner workflow. When both are set, approved actions are POSTed to the webhook
# with an HMAC signature and n8n calls back to /api/partners/callback.
# When unset, a local simulated partner sends the same callbacks.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Delay between local simulated partner updates.
MOCK_PARTNER_DELAY_MS=3500

# Not yet connected. Offers come from data/lending_offers.json until the Mochatrade API role is verified.
MOCHA_TRADE_API_URL=
MOCHA_TRADE_API_KEY=
COGNEE_API_KEY=
